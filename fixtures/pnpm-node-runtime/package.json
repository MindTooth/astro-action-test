{
  "name": "astro-action-test-pnpm-node-runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "preinstall": "node -p \"process.versions.node\" > .install-node-version && node -p \"process.execPath\" > .install-node-path"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.2",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "22.23.4",
      "onFail": "download"
    }
  },
  "dependencies": {
    "astro": "7.4.4"
  }
}
